---
interface Props {
    title: string;
    subtitle?: string;
    image?: string;
}

const { title, subtitle, image } = Astro.props;
---

<section class="hero-gradient py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="flex-1 text-center md:text-left">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-base-content mb-4 animate-fadeIn">
                    {title}
                </h1>
                {subtitle && (
                    <p class="text-xl text-base-content/70 animate-fadeIn" style="animation-delay: 0.1s">
                        {subtitle}
                    </p>
                )}
            </div>
            {image && (
                <div class="flex-1 animate-fadeIn" style="animation-delay: 0.2s">
                    <img src={image} alt={title} class="rounded-2xl shadow-2xl max-w-md mx-auto" />
                </div>
            )}
        </div>
    </div>
</section>