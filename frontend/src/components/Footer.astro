---
interface Props {
    title?: string;
    subtitle?: string;
}

const { title = "Ursoaia Edu", subtitle = "Portal educațional pentru elevi și studenți" } = Astro.props;
---

<section class="card-gradient rounded-2xl p-8 md:p-12 my-8">
    <div class="text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{title}</h2>
        <p class="text-gray-300 mb-6">{subtitle}</p>
        <div class="flex justify-center gap-4">
            <a href="/articles" class="btn btn-gradient">
                Vezi Articole
            </a>
            <a href="/search" class="btn btn-outline text-white border-white/20 hover:bg-white/10">
                Caută
            </a>
        </div>
    </div>
</section>