---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina nu a fost găsită" description="Pagina căutată nu există">
    <main class="max-w-7xl mx-auto px-4 py-24">
        <div class="text-center">
            <h1 class="text-8xl font-bold text-gradient mb-4">404</h1>
            <h2 class="text-2xl font-semibold text-white mb-4">Pagina nu a fost găsită</h2>
            <p class="text-gray-400 mb-8">
                Ne pare rău, pagina pe care o cauți nu există sau a fost mutată.
            </p>
            <div class="flex justify-center gap-4">
                <a href="/" class="btn btn-gradient">Acasă</a>
                <a href="/articles" class="btn btn-outline text-white border-white/20 hover:bg-white/10">
                    Articole
                </a>
            </div>
        </div>
    </main>
</BaseLayout>
