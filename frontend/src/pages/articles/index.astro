---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const perPage = 12;

let articles = [];
let total = 0;
let pages = 0;

try {
    const apiUrl = import.meta.env.API_URL || 'http://localhost:8000/api';
    const res = await fetch(`${apiUrl}/articles?page=${page}&per_page=${perPage}`);
    
    if (res.ok) {
        const data = await res.json();
        articles = data.items || [];
        total = data.total || 0;
        pages = data.pages || 0;
    }
} catch (error) {
    console.error('Failed to fetch articles:', error);
}
---

<BaseLayout title="Articole" description="Toate articolele educaționale de pe Ursoaia Edu">
    <main class="max-w-7xl mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold text-white mb-8">Articole</h1>
        
        {articles.length > 0 ? (
            <>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {articles.map((article: any) => (
                        <ArticleCard 
                            id={article.id}
                            title={article.title}
                            slug={article.slug}
                            excerpt={article.excerpt}
                            coverImage={article.cover_image}
                            publishedAt={article.published_at}
                            categories={article.categories}
                            tags={article.tags}
                            viewsCount={article.views_count}
                            readingTime={article.reading_time}
                        />
                    ))}
                </div>
                
                <Pagination 
                    currentPage={page}
                    totalPages={pages}
                    baseUrl="/articles"
                />
            </>
        ) : (
            <div class="text-center py-16">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto text-gray-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                <h3 class="text-lg font-semibold text-gray-400">Nu există articole</h3>
                <p class="text-gray-500">Verificați din nou mai târziu.</p>
            </div>
        )}
    </main>
</BaseLayout>