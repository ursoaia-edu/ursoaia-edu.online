---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchApi } from '../../lib/api';
import { renderTipTapContent } from '../../lib/tiptap';
import type { ArticleResponse } from '../../types/api';

const { slug } = Astro.params;

const article = await fetchApi<ArticleResponse>(`/articles/${slug}`);

if (!article) {
    return Astro.redirect('/404');
}

const formattedDate = article.published_at 
    ? new Date(article.published_at).toLocaleDateString('ro-RO', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
    })
    : '';
---

<BaseLayout title={article.title} description={article.excerpt}>
    <article class="max-w-4xl mx-auto px-4 py-12">
        {/* Header */}
        <header class="mb-8">
            {article.categories?.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                    {article.categories.map((category) => (
                        <a 
                            href={`/categories/${category.slug}`}
                            class="badge badge-lg"
                            style={`background-color: ${category.color}; color: white;`}
                        >
                            {category.name}
                        </a>
                    ))}
                </div>
            )}
            
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-4">
                {article.title}
            </h1>
            
            <div class="flex flex-wrap items-center gap-4 text-sm text-base-content/60">
                {formattedDate && (
                    <span>{formattedDate}</span>
                )}
                {article.reading_time > 0 && (
                    <span>· {article.reading_time} min citire</span>
                )}
                {article.views_count > 0 && (
                    <span>· {article.views_count} vizualizări</span>
                )}
            </div>
        </header>
        
        {/* Cover Image */}
        {article.cover_image && (
            <figure class="mb-8">
                <img 
                    src={article.cover_image} 
                    alt={article.title}
                    class="w-full rounded-2xl shadow-lg"
                />
            </figure>
        )}
        
        {/* Content */}
        <div class="prose prose-neutral prose-lg max-w-none">
            <Fragment set:html={renderTipTapContent(article.content)} />
        </div>
        
        {/* Tags */}
        {article.tags?.length > 0 && (
            <div class="mt-8 pt-8 border-t border-base-content/10">
                <div class="flex flex-wrap gap-2">
                    {article.tags.map((tag) => (
                        <a 
                            href={`/tags/${tag.slug}`}
                            class="text-sm px-3 py-1 rounded-full hover:opacity-80 transition-opacity"
                            style={`background-color: ${tag.color}20; color: ${tag.color};`}
                        >
                            #{tag.name}
                        </a>
                    ))}
                </div>
            </div>
        )}
        
        {/* Navigation */}
        <nav class="mt-8 pt-8 border-t border-base-content/10">
            <a href="/articles" class="btn btn-ghost">
                ← Înapoi la articole
            </a>
        </nav>
    </article>
</BaseLayout>
