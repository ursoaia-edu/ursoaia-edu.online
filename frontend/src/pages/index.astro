---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

// Fetch articles from API
let articles = [];
let categories = [];

try {
    const apiUrl = import.meta.env.API_URL || 'http://localhost:8000/api';
    
    const [articlesRes, categoriesRes] = await Promise.all([
        fetch(`${apiUrl}/articles?per_page=6`),
        fetch(`${apiUrl}/categories`)
    ]);
    
    if (articlesRes.ok) {
        const data = await articlesRes.json();
        articles = data.items || [];
    }
    
    if (categoriesRes.ok) {
        categories = await categoriesRes.json();
    }
} catch (error) {
    console.error('Failed to fetch data:', error);
}
---

<BaseLayout title="Acasă" description="Ursoaia Educational Portal - Resurse educaționale pentru elevi și studenți">
    <Header 
        title="Ursoaia Edu" 
        subtitle="Portal educațional cu resurse de învățare pentru elevi și studenți"
    />
    
    <main class="max-w-7xl mx-auto px-4 py-12">
        {/* Categories */}
        {categories.length > 0 && (
            <section class="mb-12">
                <h2 class="text-2xl font-bold text-white mb-6">Categorii</h2>
                <div class="flex flex-wrap gap-3">
                    {categories.map((category: any) => (
                        <a 
                            href={`/categories/${category.slug}`}
                            class="badge badge-lg hover:scale-105 transition-transform cursor-pointer"
                            style={`background-color: ${category.color}; color: white;`}
                        >
                            {category.name}
                        </a>
                    ))}
                </div>
            </section>
        )}
        
        {/* Featured Articles */}
        {articles.length > 0 && (
            <section>
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-white">Articole Recente</h2>
                    <a href="/articles" class="btn btn-ghost btn-sm text-accent">
                        Vezi toate →
                    </a>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {articles.map((article: any) => (
                        <ArticleCard 
                            id={article.id}
                            title={article.title}
                            slug={article.slug}
                            excerpt={article.excerpt}
                            coverImage={article.cover_image}
                            publishedAt={article.published_at}
                            categories={article.categories}
                            tags={article.tags}
                            viewsCount={article.views_count}
                            readingTime={article.reading_time}
                        />
                    ))}
                </div>
            </section>
        )}
        
        {articles.length === 0 && (
            <div class="text-center py-16">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto text-gray-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                <h3 class="text-lg font-semibold text-gray-400">Nu există articole</h3>
                <p class="text-gray-500">Verificați din nou mai târziu.</p>
            </div>
        )}
    </main>
    
    <div class="max-w-7xl mx-auto px-4">
        <Footer 
            title="Începe să înveți astăzi!"
            subtitle="Explorează colecția noastră de resurse educaționale"
        />
    </div>
</BaseLayout>