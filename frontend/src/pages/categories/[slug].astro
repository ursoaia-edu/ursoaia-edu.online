---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchApi } from '../../lib/api';
import type { Category, ArticleListResponse } from '../../types/api';

const { slug } = Astro.params;
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const perPage = 12;

const [category, articlesData] = await Promise.all([
    fetchApi<Category>(`/categories/${slug}`),
    fetchApi<ArticleListResponse>(`/articles?category=${slug}&page=${page}&per_page=${perPage}`)
]);

if (!category) {
    return Astro.redirect('/404');
}

const articles = articlesData?.items || [];
const pages = articlesData?.pages || 0;
---

<BaseLayout title={category.name} description={category.description || `Articole din categoria ${category.name}`}>
    <main class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <div 
                    class="w-4 h-4 rounded"
                    style={`background-color: ${category.color}`}
                />
                <h1 class="text-3xl font-bold text-white">{category.name}</h1>
            </div>
            
            {category.description && (
                <p class="text-gray-400">{category.description}</p>
            )}
        </div>
        
        {articles.length > 0 ? (
            <>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {articles.map((article) => (
                        <ArticleCard 
                            id={article.id}
                            title={article.title}
                            slug={article.slug}
                            excerpt={article.excerpt}
                            coverImage={article.cover_image}
                            publishedAt={article.published_at}
                            categories={article.categories}
                            tags={article.tags}
                            viewsCount={article.views_count}
                            readingTime={article.reading_time}
                        />
                    ))}
                </div>
                
                <Pagination 
                    currentPage={page}
                    totalPages={pages}
                    baseUrl={`/categories/${slug}`}
                />
            </>
        ) : (
            <div class="text-center py-16">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto text-gray-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                <h3 class="text-lg font-semibold text-gray-400">Nu există articole în această categorie</h3>
                <p class="text-gray-500">Verificați din nou mai târziu.</p>
            </div>
        )}
    </main>
</BaseLayout>
